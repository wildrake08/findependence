#!/bin/sh
# WI-077: distribution, through which an operator's remote console connects (and is audited, REQ-191), listens on
# the loopback interface only, as the web listener does (WI-063); so does epmd. The node is named at localhost, so
# the release's own remote, rpc, and stop commands reach it over loopback.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@localhost}"
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface {127,0,0,1}"
export ERL_EPMD_ADDRESS=127.0.0.1

# WI-079 (the security assessment's FND-18): the distribution cookie is the operator's secret, given at run time
# and never taken from the release's files; without a long one, nothing starts or connects.
if [ "${#RELEASE_COOKIE}" -lt 32 ]; then
  echo "RELEASE_COOKIE must be set to a secret of at least 32 characters (for example: openssl rand -hex 32)" >&2
  exit 1
fi
